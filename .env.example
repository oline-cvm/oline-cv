# OLINE local config (copy to .env if you want overrides)
# This project runs without secrets by default — no API keys required.

# Optional: override YOLO pose weights path
# OLINE_POSE_MODEL=yolov8m-pose.pt

# Optional: dashboard bind (used only if you wire it in)
# OLINE_HOST=127.0.0.1
# OLINE_PORT=7860

# Identity freeze / association
OLINE_FREEZE_IDENTITY=1
OLINE_TRACK_CALIB=1
# OLINE_TRACK_DEBUG_DIR=outputs/track_debug
